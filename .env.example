# Name of the existing Docker network your reverse proxy is attached to.
PROXY_NETWORK=my-proxy-network
# Your timezone, so "Today" rolls over at local midnight (e.g. Region/City).
TZ=UTC
# The one shared password for LAN mode (there are no separate accounts). Required by
# docker-compose.yml; leave it unset entirely for docker-compose.localhost.yml, which never asks
# for one. Pick a real passphrase, not a PIN -- it also doubles as your session-signing key.
KANBAN_PASSWORD=change-me
